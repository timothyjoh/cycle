{
  "name": "@cycleai/cli",
  "version": "0.0.2",
  "description": "cycle — issue-driven workflow engine for autonomous code changes",
  "license": "MIT",
  "author": "Timothy Johnson",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timothyjoh/cycle.git"
  },
  "homepage": "https://github.com/timothyjoh/cycle",
  "bugs": "https://github.com/timothyjoh/cycle/issues",
  "type": "module",
  "bin": {
    "cycle": "dist/cycle.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "pretest": "node scripts/build.mjs",
    "test": "node --test --experimental-strip-types --test-reporter=spec",
    "pretest:coverage": "node scripts/build.mjs",
    "test:coverage": "node --test --experimental-strip-types --experimental-test-coverage --test-coverage-exclude='dist/**' --test-coverage-exclude='tests/**' --test-coverage-exclude='scripts/**' --test-reporter=spec",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "smoke": "node dist/cycle.js --version",
    "sync-defaults": "node scripts/sync-defaults.mjs"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
